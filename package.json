{
  "name": "@0k/vue-side-panel",
  "version": "0.1.3",
  "description": "Shared Vue 3 side-panel chrome and interaction controller for responsive docked panels and drawers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.org",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc -p tsconfig.build.json && vite build",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "3.0.5",
    "vue": "3.5.21",
    "vue-tsc": "2.2.0"
  }
}
