{
  "name": "@0k/vue-side-panel",
  "version": "%%version%%",
  "description": "Shared Vue 3 side-panel chrome and interaction controller for responsive docked panels and drawers.",
  "keywords": [
    "vue",
    "vue3",
    "side-panel",
    "sidebar",
    "drawer",
    "resizable",
    "responsive"
  ],
  "author": "Valentin Lab <valentin.lab@kalysto.org>",
  "license": "MIT",
  "homepage": "https://github.com/0k/vue-side-panel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0k/vue-side-panel.git"
  },
  "bugs": {
    "url": "https://github.com/0k/vue-side-panel/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc -p tsconfig.build.json && vite build",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "6.4.4",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "2.2.12"
  }
}
